# Copia este archivo a .env y completa. NUNCA subas .env al repositorio.
# Todo el kit es sintético (@ejemplo.test, ERR-SIM-xxxx, KB-SIM-xxx).

# --- Modo demo: habilita «Ver como» (sin login). Debe ser false fuera de la demo.
MODO_DEMO=true
ENTORNO=local

# --- Base de datos de la app (P2). Hoy corre en otra máquina y se llega por un túnel TCP de Cloudflare:
# el servicio "db-tunel" del compose lo abre. El hostname cambia si el anfitrión reinicia el túnel.
DB_TUNEL_HOST=
# Desde los contenedores: postgresql://app_backend:<clave>@db-tunel:15432/hackathon
#   app_backend = usuario de mínimo privilegio (solo app_rw, sin evaluacion). Nunca el superusuario. ADR 0009.
# Desde tu equipo (DBeaver/pgAdmin): 127.0.0.1:15432
# Si P2 corre localmente: docker-compose.db.yml (puerto 5433). Ver db/CLAUDE.md.
# Vacías = repositorios en memoria (dobles) mientras P2 entrega.
DATABASE_URL=
DATABASE_URL_RO=
# memoria | postgres (postgres requiere el esquema "orquestador", ADR 0003)
CHECKPOINTER=memoria

# --- Capa LLM (modelos por agente en backend/config/modelos.yaml)
# real | fake  (fake = respuestas deterministas, sin red; útil sin claves)
LLM_MODO=real
# Hugging Face Inference Providers (proveedor por defecto de los agentes de chat, ADR 0012).
# Token: https://huggingface.co/settings/tokens (permiso "Make calls to Inference Providers").
HF_TOKEN=
# Organización a la que se factura el uso (cabecera X-HF-Bill-To). Vacía = se factura a la cuenta del token.
HF_BILL_TO=henkia
# OpenRouter (alternativa, fuera de las cadenas por defecto): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Ollama: el compose levanta el servicio "ollama" y la API lo usa en http://ollama:11434.
# Para usar otro Ollama (p. ej., con GPU en otra máquina) define OLLAMA_BASE_URL_CONTENEDOR.
# Primera vez: docker compose exec ollama ollama pull qwen3-embedding:0.6b
OLLAMA_BASE_URL_CONTENEDOR=
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024

# --- Langfuse self-hosted (ya corriendo en http://localhost:3000)
# Langfuse → Settings → API Keys → Create new API keys (en el proyecto del caso 5)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
# Cómo alcanza el contenedor de la API a Langfuse (por defecto http://host.docker.internal:3000)
LANGFUSE_HOST_CONTENEDOR=http://host.docker.internal:3000
LANGFUSE_ETIQUETA_PROMPTS=production

# --- Zabbix vía el servidor MCP "zabbix-ofimatica" (ADR 0007)
# Streamable HTTP. La URL es un túnel temporal de Cloudflare: si deja de responder, pide la nueva al administrador.
ZABBIX_MCP_URL=
# Vacío mientras el servidor no exija autenticación (si la agrega, va como Authorization: Bearer).
ZABBIX_MCP_TOKEN=
ZABBIX_MCP_TIMEOUT_S=75
# Solo demo: equipo de laboratorio a usar cuando el equipo de la persona no existe en Zabbix (p. ej. DESKTOP-xxxxx).
ZABBIX_EQUIPO_DEMO=
# Cuánto espera un turno la respuesta en la ventana de autorización antes de dejarla pendiente (F4)
CONSENTIMIENTO_ESPERA_MAX_S=150
CONSENTIMIENTO_ESPERA_POR_CONSULTA_S=25
# Masivos (F2, §3.11): k usuarios distintos con similitud >= umbral dentro de la ventana (minutos)
MASIVO_MIN_EQUIPOS=3
MASIVO_UMBRAL=0.75
MASIVO_VENTANA_MIN=60
# Solo con MODO_DEMO: "ahora" del clúster para reproducir los escenarios 3/3b del kit (ISO 8601).
# Con 2026-11-19T09:00:00-05:00 y MASIVO_VENTANA_MIN=2880 entran los reportes del 17 (3b) y del 19 (3).
MASIVO_RELOJ_DEMO=
# Solo si se levanta el Zabbix local de respaldo (perfil "zabbix", ADR 0005):
ZABBIX_DB_PASSWORD=

# --- Frontend
VITE_API_URL=http://localhost:8000
